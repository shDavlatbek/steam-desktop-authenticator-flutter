# Copy to .env and fill in. Never commit the real .env.

# From @BotFather.
BOT_TOKEN=..........

# Your Telegram numeric user ID. This account is the only admin — it is the
# only one that can add accounts, read codes, or handle confirmations.
# Get it from @userinfobot.
ADMIN_ID=........

# Where maFiles, manifest.json and shares.json live.
DATA_DIR=./data

# Encryption passphrase for the .maFile files at rest, using the same
# AES-256-CBC + PBKDF2 scheme as the desktop app. Strongly recommended:
# without it, anyone who reads DATA_DIR gets every shared_secret in plaintext.
# Leave empty to store unencrypted (matches the app's "no encryption" mode).
SDA_PASSKEY=........

# Optional. Seconds a decoded QR login request stays actionable. Steam expires
# these on its own too; this just avoids stale buttons hanging around.
QR_REQUEST_TTL=180
